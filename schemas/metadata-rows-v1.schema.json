{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:browser-core:metadata-rows:1",
  "title":"Focused value-free portable metadata rows",
  "description":"Opt-in fixed projection after full portable population validation. CLI emits exactly counted ASCII/LF JSON without a trailing newline, at most 16384 bytes. External transport delivery is unknown. Request metadata is same-event-only; fields omitted by this projection are not claims of absence.",
  "oneOf":[
    {"type":"object","additionalProperties":false,"required":["schema","status","code"],"properties":{
      "schema":{"const":"browser-core.metadata-rows/1"},"status":{"const":"error"},"code":{"enum":["private-values-disabled","metadata-query-revision-unavailable","metadata-recording-contains-values","metadata-realm-filter-unavailable","metadata-attribution-ambiguous","session-recording-unavailable","capture-contract-unsupported","query-unavailable","interrupted"]}}},
    {"type":"object","additionalProperties":false,
      "required":["schema","status","run_id","capture","producer_chromium_revision","reader_runtime","snapshot","recording_health","query","semantics","rows","output"],
      "dependentRequired":{"source_recording":["bundle"]},
      "properties":{
        "schema":{"const":"browser-core.metadata-rows/1"},"status":{"const":"ok"},
        "run_id":{"type":"string","maxLength":128,"pattern":"^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$","not":{"pattern":"[^A-Za-z0-9._-]"}},
        "capture":{"const":{"schema":"browser-core.metadata/1","allowlist":"none"}},
        "producer_chromium_revision":{"type":"string","pattern":"^[0-9a-f]{40}$"},
        "reader_runtime":{"type":"object"},"recording_health":{"type":"object"},
        "snapshot":{"$ref":"#/$defs/snapshot"},
        "source_recording":{"type":"object","additionalProperties":false,
          "required":["run_id","sha256","bytes","source_bytes","packets","excluded_tail_bytes","source_phase"],"properties":{
            "run_id":{"type":"string","maxLength":128,"pattern":"^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$","not":{"pattern":"[^A-Za-z0-9._-]"}},"sha256":{"$ref":"#/$defs/digest"},
            "bytes":{"$ref":"#/$defs/count"},"source_bytes":{"$ref":"#/$defs/count"},"packets":{"$ref":"#/$defs/count"},"excluded_tail_bytes":{"$ref":"#/$defs/count"},"source_phase":{"$ref":"#/$defs/phase"}}},
        "bundle":{"type":"object","additionalProperties":false,"required":["sha256","expected_digest_matched","authenticity"],"properties":{
          "sha256":{"$ref":"#/$defs/digest"},"expected_digest_matched":{"type":"boolean"},"authenticity":{"const":"unsigned-exporter-metadata"}}},
        "query":{"type":"object","additionalProperties":false,
          "required":["filters","query_sha256","requested_limit","matching_events","snapshot_max_seq","ordering","returned_events","more_available","output_limited","next_cursor"],"properties":{
            "filters":{"$ref":"#/$defs/filters"},"query_sha256":{"$ref":"#/$defs/digest"},"requested_limit":{"type":"integer","minimum":1,"maximum":100},
            "matching_events":{"$ref":"#/$defs/count"},"snapshot_max_seq":{"$ref":"#/$defs/count"},"ordering":{"const":"timestamp-descending-then-sequence-descending"},
            "returned_events":{"type":"integer","minimum":0,"maximum":100},"more_available":{"type":"boolean"},"output_limited":{"type":"boolean"},"next_cursor":{"type":["string","null"],"maxLength":1024}}},
        "rows":{"type":"array","maxItems":100,"items":{"$ref":"#/$defs/row"}},
        "output":{"type":"object","additionalProperties":false,
          "required":["max_rendered_json_bytes","rendered_json_bytes","byte_limit_applied","transport_delivery_verified","transport_truncated"],"properties":{
            "max_rendered_json_bytes":{"const":16384},"rendered_json_bytes":{"type":"integer","minimum":1,"maximum":16384},"byte_limit_applied":{"type":"boolean"},
            "transport_delivery_verified":{"const":false},"transport_truncated":{"const":null}}},
        "semantics":{"type":"object","additionalProperties":false,
          "required":["private_values_included","private_value_records","population","full_snapshot_decode","api_filter","script_id","context_kind","parent_events_may_be_outside_page","continuation_supported","cursor_authenticated","cursor_authorizes_actions","query_launched_browser","active_probe","proves_capture_complete","server_side_architecture_observed","population_validated_before_filtering","projection","request_metadata","request_url_path","unprojected_fields","continuation"],"properties":{
            "private_values_included":{"const":false},"private_value_records":{"const":0},"population":{"const":"validated-portable-native-events"},"full_snapshot_decode":{"const":true},
            "api_filter":{"const":"exact-portable-event-name"},"script_id":{"const":"native-v8-script-number"},"context_kind":{"const":"frame-worker-marker-or-other"},
            "parent_events_may_be_outside_page":{"const":true},"continuation_supported":{"type":"boolean"},"cursor_authenticated":{"const":false},"cursor_authorizes_actions":{"const":false},
            "query_launched_browser":{"const":false},"active_probe":{"const":false},"proves_capture_complete":{"const":false},"server_side_architecture_observed":{"const":false},
            "population_validated_before_filtering":{"const":true},"projection":{"const":"portable-identifiers-parents-request-metadata"},"request_metadata":{"const":"same-event-only-no-inferred-join"},"request_url_path":{"const":"always-redacted"},
            "unprojected_fields":{"const":"omitted-not-observed-absent"},"continuation":{"enum":["verified-immutable-bundle","collect-immutable-bundle-for-continuation"]}}}
      }
    }
  ],
  "$defs":{
    "digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"count":{"type":"string","pattern":"^(0|[1-9][0-9]{0,18})$"},
    "phase":{"enum":["live-prefix","finalized-recording","recovered-prefix","interrupted-recording","limited-recording"]},
    "snapshot":{"type":"object","additionalProperties":false,"required":["sha256","bytes","source_bytes","packets","excluded_tail_bytes","source_phase"],"properties":{
      "sha256":{"$ref":"#/$defs/digest"},"bytes":{"$ref":"#/$defs/count"},"source_bytes":{"$ref":"#/$defs/count"},"packets":{"$ref":"#/$defs/count"},"excluded_tail_bytes":{"$ref":"#/$defs/count"},"source_phase":{"$ref":"#/$defs/phase"}}},
    "filters":{"type":"object","additionalProperties":false,"required":["search","script","context"],"properties":{
      "search":{"const":""},"script":{"type":"string","pattern":"^(-1|0|[1-9][0-9]{0,18})?$"},"context":{"enum":["","window","worker","other"]},
      "apis":{"type":"array","minItems":1,"maxItems":32,"uniqueItems":true,"items":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]{0,255}$"}},
      "start_ns":{"$ref":"#/$defs/count"},"end_ns":{"$ref":"#/$defs/count"},
      "portable_context":{"type":"object","additionalProperties":false,"required":["pid","context_id"],"properties":{"pid":{"type":"string","pattern":"^[1-9][0-9]{0,18}$"},"context_id":{"type":"string","minLength":1,"maxLength":256}}}}},
    "row":{"type":"object","additionalProperties":false,
      "required":["seq","timestamp_ns","pid","api","category","context","script_id","parents","request"],"properties":{
        "seq":{"$ref":"#/$defs/count"},"timestamp_ns":{"$ref":"#/$defs/count"},"pid":{"$ref":"#/$defs/count"},
        "api":{"type":"string","minLength":1,"maxLength":256},"category":{"enum":["execution","api","crypto","wasm","message","network","stream","diagnostic"]},
        "context":{"type":"object","additionalProperties":false,"required":["id","kind"],"properties":{"id":{"type":["string","null"],"minLength":1,"maxLength":256},"kind":{"enum":["worker","window","other"]}}},
        "script_id":{"type":["string","null"],"minLength":1,"maxLength":512},
        "parents":{"type":"object","additionalProperties":false,"properties":{
          "causal_parent_seq":{"$ref":"#/$defs/count"},"callback_parent_seq":{"$ref":"#/$defs/count"},"promise_parent_seq":{"$ref":"#/$defs/count"},"dynamic_code_parent_seq":{"$ref":"#/$defs/count"},"message_dispatch_parent_seq":{"$ref":"#/$defs/count"}}},
        "request":{"oneOf":[{"type":"null"},{"type":"object","additionalProperties":false,"required":["id","method","url_class","body_bytes","target_scope"],"properties":{
          "id":{"type":"string","minLength":1,"maxLength":512},"method":{"type":"string","minLength":1,"maxLength":64},"url_class":{"type":"string","pattern":"^(?:[a-z][a-z0-9+.-]{0,63}:)?(?:same-origin|cross-origin):<redacted>$"},
          "body_bytes":{"$ref":"#/$defs/count"},"target_scope":{"enum":["loopback","external","non-network",null]}}}]}
      }}
  }
}
