{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:browser-core:agent-research:1",
  "description": "Structural contract. The Python protocol additionally checks byte bounds, strict JSON, event order, expected workspace/profile/run binding, EOF, and exit/status/count relationships.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "event"
      ],
      "properties": {
        "schema": {
          "const": "browser-core.agent-research/1"
        },
        "event": {
          "const": "awaiting-start"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "event",
        "run_id",
        "session_file",
        "profile_id",
        "created_profile",
        "profile_retained_on_exit"
      ],
      "properties": {
        "schema": {
          "const": "browser-core.agent-research/1"
        },
        "event": {
          "const": "ready"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "session_file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\u0000-\\u001f]+$"
        },
        "profile_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "created_profile": {
          "type": "boolean"
        },
        "profile_retained_on_exit": {
          "const": true
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "event",
        "status",
        "code",
        "launch_attempted",
        "session_received",
        "cleanup_verified",
        "cleanup_error",
        "shutdown"
      ],
      "properties": {
        "schema": {
          "const": "browser-core.agent-research/1"
        },
        "event": {
          "const": "closed"
        },
        "status": {
          "enum": [
            "ok",
            "error",
            "interrupted"
          ]
        },
        "code": {
          "enum": [
            "input-closed",
            "stopped",
            "cancelled-before-start",
            "invalid-options",
            "input-unavailable",
            "command-too-large",
            "invalid-command",
            "output-unavailable",
            "invalid-session-handoff",
            "interrupted",
            "launch-failed",
            "internal-error"
          ]
        },
        "launch_attempted": {
          "type": "boolean"
        },
        "session_received": {
          "type": "boolean"
        },
        "cleanup_verified": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "cleanup_error": {
          "enum": [
            null,
            "cleanup-failed",
            "cleanup-interrupted"
          ]
        },
        "shutdown": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "run_id",
                "state",
                "running",
                "identity_protected"
              ],
              "properties": {
                "run_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                },
                "state": {
                  "const": "stopped"
                },
                "running": {
                  "const": false
                },
                "identity_protected": {
                  "const": true
                },
                "shutdown_mode": {
                  "enum": [
                    "graceful",
                    "forced",
                    "exited-before-force"
                  ]
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "session_received": {
                "const": true
              }
            },
            "required": [
              "session_received"
            ]
          },
          "then": {
            "properties": {
              "launch_attempted": {
                "const": true
              },
              "cleanup_verified": {
                "type": "boolean"
              }
            }
          },
          "else": {
            "properties": {
              "cleanup_verified": {
                "const": null
              },
              "cleanup_error": {
                "const": null
              },
              "shutdown": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "cleanup_verified": {
                "const": true
              }
            },
            "required": [
              "cleanup_verified"
            ]
          },
          "then": {
            "properties": {
              "cleanup_error": {
                "const": null
              },
              "shutdown": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "run_id",
                  "state",
                  "running",
                  "identity_protected"
                ],
                "properties": {
                  "run_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                  },
                  "state": {
                    "const": "stopped"
                  },
                  "running": {
                    "const": false
                  },
                  "identity_protected": {
                    "const": true
                  },
                  "shutdown_mode": {
                    "enum": [
                      "graceful",
                      "forced",
                      "exited-before-force"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "cleanup_verified": {
                "const": false
              }
            },
            "required": [
              "cleanup_verified"
            ]
          },
          "then": {
            "properties": {
              "cleanup_error": {
                "enum": [
                  "cleanup-failed",
                  "cleanup-interrupted"
                ]
              },
              "shutdown": {
                "const": null
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "enum": [
                  "cancelled-before-start",
                  "invalid-options"
                ]
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "launch_attempted": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "enum": [
                  "stopped",
                  "invalid-session-handoff"
                ]
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "session_received": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "launch-failed"
              }
            },
            "required": [
              "code"
            ]
          },
          "then": {
            "properties": {
              "launch_attempted": {
                "const": true
              },
              "session_received": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "code": {
                "const": "input-closed"
              },
              "launch_attempted": {
                "const": true
              }
            },
            "required": [
              "code",
              "launch_attempted"
            ]
          },
          "then": {
            "properties": {
              "session_received": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "cleanup_error": {
                "const": "cleanup-interrupted"
              }
            },
            "required": [
              "cleanup_error"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "const": "interrupted"
              }
            }
          },
          "else": {
            "if": {
              "properties": {
                "cleanup_error": {
                  "const": "cleanup-failed"
                }
              },
              "required": [
                "cleanup_error"
              ]
            },
            "then": {
              "properties": {
                "status": {
                  "const": "error"
                }
              }
            },
            "else": {
              "if": {
                "properties": {
                  "code": {
                    "const": "interrupted"
                  }
                },
                "required": [
                  "code"
                ]
              },
              "then": {
                "properties": {
                  "status": {
                    "const": "interrupted"
                  }
                }
              },
              "else": {
                "if": {
                  "properties": {
                    "code": {
                      "enum": [
                        "input-closed",
                        "stopped",
                        "cancelled-before-start"
                      ]
                    }
                  },
                  "required": [
                    "code"
                  ]
                },
                "then": {
                  "properties": {
                    "status": {
                      "const": "ok"
                    }
                  }
                },
                "else": {
                  "properties": {
                    "status": {
                      "const": "error"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  ]
}
