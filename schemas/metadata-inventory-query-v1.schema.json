{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:browser-core:metadata-inventory-query:1",
  "title": "Inventory-only validated native metadata query",
  "description": "Separate inventory-only contract. Full bounded snapshot export and population validation precede all filters. Inventory CLI emits the counted ASCII/LF JSON bytes directly, without a terminal newline, at most 16384 bytes; external transport delivery is not verified. Saved-bundle results separately preserve the verified original source_recording.",
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "count": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18})$"
    },
    "apiGroups": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_groups",
        "reported_groups",
        "truncated",
        "groups"
      ],
      "properties": {
        "total_groups": {
          "type": "integer",
          "minimum": 0
        },
        "reported_groups": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "truncated": {
          "type": "boolean"
        },
        "groups": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "api",
              "events"
            ],
            "properties": {
              "api": {
                "type": "string"
              },
              "events": {
                "$ref": "#/$defs/count"
              }
            }
          }
        }
      }
    },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "scope",
        "matching_events",
        "context_kind_counts",
        "contexts",
        "apis",
        "analyst_instrumentation",
        "context_identity_proves_process_isolation",
        "pid_is_recorded_renderer_identity_not_control_authority",
        "source_url_to_script_mapping_established"
      ],
      "properties": {
        "schema": {
          "const": "browser-core.metadata-inventory/1"
        },
        "scope": {
          "const": "all-matching-events-before-pagination"
        },
        "matching_events": {
          "$ref": "#/$defs/count"
        },
        "context_kind_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "window",
            "worker",
            "other"
          ],
          "properties": {
            "window": {
              "$ref": "#/$defs/count"
            },
            "worker": {
              "$ref": "#/$defs/count"
            },
            "other": {
              "$ref": "#/$defs/count"
            }
          }
        },
        "apis": {
          "$ref": "#/$defs/apiGroups"
        },
        "contexts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total_groups",
            "reported_groups",
            "truncated",
            "groups"
          ],
          "properties": {
            "total_groups": {
              "type": "integer",
              "minimum": 0
            },
            "reported_groups": {
              "type": "integer",
              "minimum": 0,
              "maximum": 16
            },
            "truncated": {
              "type": "boolean"
            },
            "groups": {
              "type": "array",
              "maxItems": 16,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "pid",
                  "context_id",
                  "frame_id",
                  "worker_id",
                  "kind",
                  "events",
                  "apis"
                ],
                "properties": {
                  "pid": {
                    "$ref": "#/$defs/count"
                  },
                  "context_id": {
                    "type": "string"
                  },
                  "frame_id": {
                    "type": "string"
                  },
                  "worker_id": {
                    "type": "string"
                  },
                  "kind": {
                    "enum": [
                      "window",
                      "worker",
                      "other"
                    ]
                  },
                  "events": {
                    "$ref": "#/$defs/count"
                  },
                  "apis": {
                    "$ref": "#/$defs/apiGroups"
                  }
                }
              }
            }
          }
        },
        "analyst_instrumentation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "declared_activities",
            "declaration_source",
            "activity_presence",
            "event_ownership",
            "declaration_assigns_events"
          ],
          "properties": {
            "declared_activities": {
              "type": "array",
              "maxItems": 3,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "browser-control",
                  "page-evaluation",
                  "source-acquisition"
                ]
              }
            },
            "declaration_source": {
              "const": "caller"
            },
            "activity_presence": {
              "enum": [
                "declared",
                "unknown"
              ]
            },
            "event_ownership": {
              "const": "unresolved"
            },
            "declaration_assigns_events": {
              "const": false
            }
          }
        },
        "context_identity_proves_process_isolation": {
          "const": false
        },
        "pid_is_recorded_renderer_identity_not_control_authority": {
          "const": true
        },
        "source_url_to_script_mapping_established": {
          "const": false
        }
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "status",
        "run_id",
        "capture",
        "reader_runtime",
        "snapshot",
        "recording_health",
        "query",
        "semantics",
        "inventory",
        "producer_chromium_revision",
        "output"
      ],
      "properties": {
        "schema": {
          "const": "browser-core.metadata-inventory-query/1"
        },
        "status": {
          "const": "ok"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]{1,128}$"
        },
        "capture": {
          "const": {
            "schema": "browser-core.metadata/1",
            "allowlist": "none"
          }
        },
        "reader_runtime": {
          "type": "object"
        },
        "recording_health": {
          "type": "object"
        },
        "inventory": {
          "$ref": "#/$defs/inventory"
        },
        "bundle": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "expected_digest_matched",
            "authenticity"
          ],
          "properties": {
            "sha256": {
              "$ref": "#/$defs/digest"
            },
            "expected_digest_matched": {
              "type": "boolean"
            },
            "authenticity": {
              "const": "unsigned-exporter-metadata"
            }
          }
        },
        "snapshot": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "bytes",
            "source_bytes",
            "packets",
            "excluded_tail_bytes",
            "source_phase"
          ],
          "properties": {
            "sha256": {
              "$ref": "#/$defs/digest"
            },
            "bytes": {
              "$ref": "#/$defs/count"
            },
            "source_bytes": {
              "$ref": "#/$defs/count"
            },
            "packets": {
              "$ref": "#/$defs/count"
            },
            "excluded_tail_bytes": {
              "$ref": "#/$defs/count"
            },
            "source_phase": {
              "enum": [
                "live-prefix",
                "finalized-recording",
                "recovered-prefix",
                "interrupted-recording",
                "limited-recording"
              ]
            }
          }
        },
        "query": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "filters",
            "query_sha256",
            "matching_events",
            "snapshot_max_seq",
            "returned_events"
          ],
          "properties": {
            "filters": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "search",
                "script",
                "context"
              ],
              "properties": {
                "search": {
                  "const": ""
                },
                "script": {
                  "type": "string",
                  "pattern": "^(|-1|0|[1-9][0-9]{0,18})$"
                },
                "context": {
                  "enum": [
                    "",
                    "window",
                    "worker",
                    "other"
                  ]
                },
                "apis": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 32,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,255}$"
                  }
                },
                "start_ns": {
                  "$ref": "#/$defs/count"
                },
                "end_ns": {
                  "$ref": "#/$defs/count"
                },
                "portable_context": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "pid",
                    "context_id"
                  ],
                  "properties": {
                    "pid": {
                      "type": "string",
                      "pattern": "^[1-9][0-9]{0,18}$"
                    },
                    "context_id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 256
                    }
                  }
                }
              }
            },
            "query_sha256": {
              "$ref": "#/$defs/digest"
            },
            "matching_events": {
              "$ref": "#/$defs/count"
            },
            "snapshot_max_seq": {
              "$ref": "#/$defs/count"
            },
            "returned_events": {
              "const": 0
            }
          }
        },
        "semantics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "private_values_included",
            "private_value_records",
            "population",
            "full_snapshot_decode",
            "api_filter",
            "script_id",
            "context_kind",
            "continuation_supported",
            "query_launched_browser",
            "active_probe",
            "proves_capture_complete",
            "server_side_architecture_observed",
            "event_rows_included",
            "population_validated_before_filtering"
          ],
          "properties": {
            "private_values_included": {
              "const": false
            },
            "private_value_records": {
              "const": 0
            },
            "population": {
              "const": "validated-portable-native-events"
            },
            "full_snapshot_decode": {
              "const": true
            },
            "api_filter": {
              "const": "exact-portable-event-name"
            },
            "script_id": {
              "const": "native-v8-script-number"
            },
            "context_kind": {
              "const": "frame-worker-marker-or-other"
            },
            "continuation_supported": {
              "const": false
            },
            "query_launched_browser": {
              "const": false
            },
            "active_probe": {
              "const": false
            },
            "proves_capture_complete": {
              "const": false
            },
            "server_side_architecture_observed": {
              "const": false
            },
            "event_rows_included": {
              "const": false
            },
            "population_validated_before_filtering": {
              "const": true
            }
          }
        },
        "producer_chromium_revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "output": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_rendered_json_bytes",
            "rendered_json_bytes",
            "byte_limit_applied",
            "summaries_truncated",
            "transport_delivery_verified",
            "transport_truncated"
          ],
          "properties": {
            "max_rendered_json_bytes": {
              "const": 16384
            },
            "rendered_json_bytes": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16384
            },
            "byte_limit_applied": {
              "type": "boolean"
            },
            "summaries_truncated": {
              "type": "boolean"
            },
            "transport_delivery_verified": {
              "const": false
            },
            "transport_truncated": {
              "type": "null"
            }
          }
        },
        "source_recording": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "bytes",
            "source_bytes",
            "packets",
            "excluded_tail_bytes",
            "source_phase",
            "run_id"
          ],
          "properties": {
            "sha256": {
              "$ref": "#/$defs/digest"
            },
            "bytes": {
              "$ref": "#/$defs/count"
            },
            "source_bytes": {
              "$ref": "#/$defs/count"
            },
            "packets": {
              "$ref": "#/$defs/count"
            },
            "excluded_tail_bytes": {
              "$ref": "#/$defs/count"
            },
            "source_phase": {
              "enum": [
                "live-prefix",
                "finalized-recording",
                "recovered-prefix",
                "interrupted-recording",
                "limited-recording"
              ]
            },
            "run_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9-]{1,128}$"
            }
          }
        }
      },
      "dependentRequired": {
        "source_recording": [
          "bundle"
        ]
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "status",
        "code"
      ],
      "properties": {
        "schema": {
          "const": "browser-core.metadata-inventory-query/1"
        },
        "status": {
          "const": "error"
        },
        "code": {
          "enum": [
            "query-unavailable",
            "interrupted",
            "private-values-disabled",
            "metadata-query-revision-unavailable",
            "metadata-recording-contains-values",
            "metadata-realm-filter-unavailable",
            "metadata-attribution-ambiguous",
            "session-recording-unavailable",
            "capture-contract-unsupported"
          ]
        }
      }
    }
  ]
}
