{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "browser-core.script-source-match/1",
  "oneOf": [
    {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "status", "code"],
      "properties": {
        "schema": {"const": "browser-core.script-source-match/1"},
        "status": {"const": "error"},
        "code": {"const": "script-source-match-unavailable"}
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema", "status", "run_id", "trace_sha256", "trusted_digest_matched",
        "trace_events", "dropped_events", "candidate_utf16_code_units",
        "compiler_input_limit_units", "counts", "matches", "matches_truncated",
        "run_link_scope", "limits"
      ],
      "properties": {
        "schema": {"const": "browser-core.script-source-match/1"},
        "status": {"enum": ["matched", "not-observed", "digest-coverage-limited", "digest-unavailable", "candidate-over-limit"]},
        "run_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "trace_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "trusted_digest_matched": {"type": "boolean"},
        "trace_events": {"$ref": "#/$defs/count"},
        "dropped_events": {"$ref": "#/$defs/count"},
        "candidate_utf16_code_units": {"$ref": "#/$defs/count"},
        "compiler_input_limit_units": {"const": 262144},
        "counts": {
          "type": "object", "additionalProperties": false,
          "required": ["identity_events", "observed_digests", "over_limit", "unavailable", "matches"],
          "properties": {
            "identity_events": {"$ref": "#/$defs/count"},
            "observed_digests": {"$ref": "#/$defs/count"},
            "over_limit": {"$ref": "#/$defs/count"},
            "unavailable": {"$ref": "#/$defs/count"},
            "matches": {"$ref": "#/$defs/count"}
          }
        },
        "matches": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/match"}},
        "matches_truncated": {"type": "boolean"},
        "run_link_scope": {"const": "same-process-thread-numeric-script-id-and-later-time-only"},
        "limits": {"type": "array", "minItems": 4, "maxItems": 4,
                   "items": {"type": "string", "minLength": 1, "maxLength": 1024}}
      }
    }
  ],
  "$defs": {
    "count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "match": {
      "type": "object", "additionalProperties": false,
      "required": ["seq", "timestamp_ns", "pid", "thread_id", "script_id",
                   "source_length", "compatible_run_count", "compatible_run_seqs",
                   "compatible_runs_truncated"],
      "properties": {
        "seq": {"$ref": "#/$defs/count"},
        "timestamp_ns": {"$ref": "#/$defs/count"},
        "pid": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "thread_id": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "script_id": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "source_length": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "compatible_run_count": {"$ref": "#/$defs/count"},
        "compatible_run_seqs": {"type": "array", "maxItems": 16,
                                "items": {"$ref": "#/$defs/count"}},
        "compatible_runs_truncated": {"type": "boolean"}
      }
    }
  }
}
