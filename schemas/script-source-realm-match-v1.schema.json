{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "browser-core.script-source-realm-match/1",
  "oneOf": [
    {
      "type": "object", "additionalProperties": false,
      "required": ["schema", "status", "code"],
      "properties": {
        "schema": {"const": "browser-core.script-source-realm-match/1"},
        "status": {"const": "error"},
        "code": {"const": "script-source-realm-match-unavailable"}
      }
    },
    {
      "type": "object", "additionalProperties": false,
      "required": [
        "schema", "status", "run_id", "trace_sha256", "trusted_digest_matched",
        "trace_events", "dropped_events", "candidate_utf16_code_units",
        "compiler_input_limit_units", "counts", "matches", "matches_truncated",
        "run_link_scope", "api_link_scope", "limits"
      ],
      "properties": {
        "schema": {"const": "browser-core.script-source-realm-match/1"},
        "status": {"enum": ["matched", "not-observed", "digest-coverage-limited", "digest-unavailable", "candidate-over-limit"]},
        "run_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "trace_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "trusted_digest_matched": {"type": "boolean"},
        "trace_events": {"$ref": "#/$defs/count"},
        "dropped_events": {"$ref": "#/$defs/count"},
        "candidate_utf16_code_units": {"$ref": "#/$defs/count"},
        "compiler_input_limit_units": {"const": 262144},
        "counts": {
          "type": "object", "additionalProperties": false,
          "required": ["context_events", "observed_digests", "over_limit", "unavailable", "matches", "matches_with_realm"],
          "properties": {
            "context_events": {"$ref": "#/$defs/count"},
            "observed_digests": {"$ref": "#/$defs/count"},
            "over_limit": {"$ref": "#/$defs/count"},
            "unavailable": {"$ref": "#/$defs/count"},
            "matches": {"$ref": "#/$defs/count"},
            "matches_with_realm": {"$ref": "#/$defs/count"}
          }
        },
        "matches": {"type": "array", "maxItems": 32, "items": {"$ref": "#/$defs/match"}},
        "matches_truncated": {"type": "boolean"},
        "run_link_scope": {"const": "same-process-thread-frame-realm-script-id-and-later-time-only"},
        "api_link_scope": {"const": "same-process-thread-v8-context-world-root-script-id-and-later-time-only"},
        "limits": {"type": "array", "minItems": 6, "maxItems": 6,
                   "items": {"type": "string", "minLength": 1, "maxLength": 1024}}
      }
    }
  ],
  "$defs": {
    "count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "group": {
      "type": "object", "additionalProperties": false,
      "required": ["api", "count"],
      "properties": {
        "api": {"type": "string", "minLength": 1, "maxLength": 160},
        "count": {"$ref": "#/$defs/count"}
      }
    },
    "match": {
      "type": "object", "additionalProperties": false,
      "required": [
        "seq", "timestamp_ns", "pid", "thread_id", "context_id", "script_id",
        "source_length", "realm_status", "v8_context_id", "realm_id",
        "compatible_run_count", "compatible_run_seqs", "compatible_runs_truncated", "run_link_status",
        "compatible_api_count", "compatible_api_seqs", "compatible_apis_truncated",
        "compatible_api_groups_total", "compatible_api_groups", "compatible_api_groups_truncated", "api_link_status"
      ],
      "properties": {
        "seq": {"$ref": "#/$defs/count"},
        "timestamp_ns": {"$ref": "#/$defs/count"},
        "pid": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "thread_id": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "context_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "script_id": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "source_length": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "realm_status": {"enum": ["observed", "unavailable"]},
        "v8_context_id": {"type": ["string", "null"], "pattern": "^[0-9A-F]{32}$"},
        "realm_id": {"type": ["integer", "null"], "minimum": 0, "maximum": 2147483647},
        "compatible_run_count": {"$ref": "#/$defs/count"},
        "compatible_run_seqs": {"type": "array", "maxItems": 16,
                                "items": {"$ref": "#/$defs/count"}},
        "compatible_runs_truncated": {"type": "boolean"},
        "run_link_status": {"enum": ["compatible-run-observed", "no-compatible-run-observed", "realm-unavailable", "ambiguous-realm-script-id", "evidence-incomplete"]},
        "compatible_api_count": {"$ref": "#/$defs/count"},
        "compatible_api_seqs": {"type": "array", "maxItems": 16,
                                "items": {"$ref": "#/$defs/count"}},
        "compatible_apis_truncated": {"type": "boolean"},
        "compatible_api_groups_total": {"$ref": "#/$defs/count"},
        "compatible_api_groups": {"type": "array", "maxItems": 16,
                                  "items": {"$ref": "#/$defs/group"}},
        "compatible_api_groups_truncated": {"type": "boolean"},
        "api_link_status": {"enum": ["compatible-api-observed", "no-compatible-api-observed", "realm-unavailable", "ambiguous-realm-script-id", "evidence-incomplete"]}
      }
    }
  }
}
