{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:browser-core:evidence-stop-timeouts:1",
  "title": "Bounded saved-recording stop-timeout diagnostics",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema", "status", "source", "details_status",
        "recorded_stop_timeouts", "last_timeout_pending_instances",
        "last_timeout_pending_producers", "last_timeout_details_truncated",
        "details", "semantics"
      ],
      "properties": {
        "schema": {"const": "browser-core.evidence-stop-timeouts/1"},
        "status": {"const": "ok"},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bundle_sha256", "recording_sha256", "expected_digest_matched"],
          "properties": {
            "bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "recording_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "expected_digest_matched": {"type": "boolean"}
          }
        },
        "details_status": {
          "enum": [
            "complete-last-timeout", "truncated-last-timeout", "unavailable",
            "unknown"
          ]
        },
        "recorded_stop_timeouts": {"$ref": "#/$defs/nullable_count"},
        "last_timeout_pending_instances": {"$ref": "#/$defs/nullable_count"},
        "last_timeout_pending_producers": {"$ref": "#/$defs/nullable_count"},
        "last_timeout_details_truncated": {"type": ["boolean", "null"]},
        "details": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "index", "producer_id", "instance_id", "state",
              "producer_name_fnv1a_63", "data_source_name_fnv1a_63"
            ],
            "properties": {
              "index": {"type": "integer", "minimum": 0, "maximum": 31},
              "producer_id": {"$ref": "#/$defs/producer_id"},
              "instance_id": {"$ref": "#/$defs/positive_count"},
              "state": {
                "enum": ["configured", "starting", "started", "stopping"]
              },
              "producer_name_fnv1a_63": {"$ref": "#/$defs/count"},
              "data_source_name_fnv1a_63": {"$ref": "#/$defs/count"}
            }
          }
        },
        "semantics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "detail_scope", "producer_and_instance_ids", "name_labels",
            "cause_identified", "recording_health_qualified",
            "proves_capture_complete", "browser_launched", "private_values_included",
            "outer_delivery_verified"
          ],
          "properties": {
            "detail_scope": {"const": "last-reported-timeout-only"},
            "producer_and_instance_ids": {"const": "run-local"},
            "name_labels": {
              "const": "noncryptographic-fnv1a-63-not-authentication-or-confidentiality"
            },
            "cause_identified": {"const": false},
            "recording_health_qualified": {"const": false},
            "proves_capture_complete": {"const": false},
            "browser_launched": {"const": false},
            "private_values_included": {"const": false},
            "outer_delivery_verified": {"const": false}
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"details_status": {"const": "unknown"}}},
          "then": {"properties": {
            "recorded_stop_timeouts": {"type": "null"},
            "last_timeout_pending_instances": {"type": "null"},
            "last_timeout_pending_producers": {"type": "null"},
            "last_timeout_details_truncated": {"type": "null"},
            "details": {"maxItems": 0}
          }}
        },
        {
          "if": {"properties": {"details_status": {"const": "unavailable"}}},
          "then": {"properties": {
            "recorded_stop_timeouts": {"$ref": "#/$defs/positive_count"},
            "last_timeout_pending_instances": {"type": "null"},
            "last_timeout_pending_producers": {"type": "null"},
            "last_timeout_details_truncated": {"type": "null"},
            "details": {"maxItems": 0}
          }}
        },
        {
          "if": {"properties": {"details_status": {"const": "complete-last-timeout"}}},
          "then": {"properties": {
            "recorded_stop_timeouts": {"$ref": "#/$defs/positive_count"},
            "last_timeout_pending_instances": {"$ref": "#/$defs/positive_count"},
            "last_timeout_pending_producers": {"$ref": "#/$defs/positive_count"},
            "last_timeout_details_truncated": {"const": false},
            "details": {"minItems": 1}
          }}
        },
        {
          "if": {"properties": {"details_status": {"const": "truncated-last-timeout"}}},
          "then": {"properties": {
            "recorded_stop_timeouts": {"$ref": "#/$defs/positive_count"},
            "last_timeout_pending_instances": {"$ref": "#/$defs/positive_count"},
            "last_timeout_pending_producers": {"$ref": "#/$defs/positive_count"},
            "last_timeout_details_truncated": {"const": true},
            "details": {"minItems": 32, "maxItems": 32}
          }}
        }
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "status", "code"],
      "properties": {
        "schema": {"const": "browser-core.evidence-stop-timeouts/1"},
        "status": {"const": "error"},
        "code": {"enum": ["stop-timeout-details-unavailable", "interrupted"]}
      }
    }
  ],
  "$defs": {
    "count": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,18})$"},
    "positive_count": {"type": "string", "pattern": "^[1-9][0-9]{0,18}$"},
    "producer_id": {"type": "string", "pattern": "^(?:[1-9]|[1-9][0-9]{1,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5])$"},
    "nullable_count": {
      "oneOf": [{"$ref": "#/$defs/count"}, {"type": "null"}]
    }
  }
}
