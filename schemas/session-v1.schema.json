{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "browser-core.session/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "run_id", "chromium_revision", "pid", "automation"],
  "properties": {
    "schema": {"const": "browser-core.session/1"},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "chromium_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "pid": {"type": "integer", "minimum": 1},
    "state": {"enum": ["active", "stopped"]},
    "created_at": {"type": "string", "minLength": 1},
    "stopped_at": {"type": "string", "minLength": 1},
    "executable": {"type": "string", "minLength": 1},
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provenance", "executable_sha256_16"],
      "properties": {
        "provenance": {"enum": ["attested-browser-core", "unverified-external"]},
        "executable_sha256_16": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
        "runtime_bundle_sha256_16": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
        "attestation_created_at": {"type": "string", "minLength": 1}
      }
    },
    "process_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pid", "executable", "start_marker"],
      "properties": {
        "pid": {"type": "integer", "minimum": 1},
        "executable": {"type": "string", "minLength": 1},
        "start_marker": {"type": "string", "minLength": 1}
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "persistence", "path", "lock_path"],
      "properties": {
        "id": {"type": ["string", "null"]},
        "persistence": {"enum": ["ephemeral", "persistent"]},
        "path": {"type": "string", "minLength": 1},
        "lock_path": {"type": ["string", "null"]},
        "directory_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["device", "inode", "file_type", "attributes"],
          "properties": {
            "device": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,31})$"},
            "inode": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,31})$"},
            "file_type": {"type": "integer", "minimum": 0},
            "attributes": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "identity_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "path", "sha256_16", "fields"],
      "properties": {
        "file": {"const": "identity-contract.json"},
        "path": {"type": "string", "minLength": 1},
        "sha256_16": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
        "fields": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    },
    "persona": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sha256_16"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "sha256_16": {"type": "string", "pattern": "^[0-9a-f]{16}$"}
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route_id", "route_sha256_16", "mode", "policies", "preflight", "runtime_identity", "realization"],
      "properties": {
        "route_id": {"type": "string", "minLength": 1},
        "route_sha256_16": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
        "mode": {"enum": ["direct", "proxy"]},
        "policies": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dns", "webrtc", "require_alignment"],
          "properties": {
            "dns": {"enum": ["route", "system"]},
            "webrtc": {"enum": ["route-only", "default"]},
            "require_alignment": {"type": "boolean"}
          }
        },
        "preflight": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema", "route_id", "route_sha256_16", "passed"],
          "properties": {
            "schema": {"const": "browser-core.network-preflight/1"},
            "route_id": {"type": "string", "minLength": 1},
            "route_sha256_16": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
            "endpoint_sha256_16": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
            "protocol": {"enum": ["direct", "http", "https", "socks5"]},
            "credential_refs_resolved": {"type": "boolean"},
            "target_host": {"type": "string", "minLength": 1, "maxLength": 253},
            "target_port": {"type": "integer", "minimum": 1, "maximum": 65535},
            "latency_ms": {"type": "integer", "minimum": 0, "maximum": 86400000},
            "passed": {"const": true}
          }
        },
        "runtime_identity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema", "locale", "languages", "timezone", "cdp_domains_enabled"],
          "properties": {
            "schema": {"const": "browser-core.runtime-identity-observation/1"},
            "locale": {"type": "string", "minLength": 1},
            "languages": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
            "timezone": {"type": "string", "minLength": 1},
            "cdp_domains_enabled": {"const": []}
          }
        },
        "realization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema", "route_id", "route_sha256_16", "passed", "observed"],
          "properties": {
            "schema": {"const": "browser-core.geo-realization/1"},
            "route_id": {"type": "string", "minLength": 1},
            "route_sha256_16": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
            "required": {"type": "boolean"},
            "passed": {"type": "boolean"},
            "checks": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "country": {"type": ["boolean", "null"]},
                "timezone": {"type": ["boolean", "null"]},
                "locale": {"type": ["boolean", "null"]},
                "coordinates": {"type": ["boolean", "null"]},
                "egress_timezone": {"type": ["boolean", "null"]}
              }
            },
            "distance_km": {"type": ["number", "null"], "minimum": 0, "maximum": 21000},
            "observed": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ip_sha256_16"],
              "properties": {
                "ip_sha256_16": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
                "country": {"type": "string", "minLength": 1},
                "timezone": {"type": "string", "minLength": 1},
                "locale": {"type": "string", "minLength": 1},
                "latitude": {"type": "number", "minimum": -90, "maximum": 90},
                "longitude": {"type": "number", "minimum": -180, "maximum": 180}
              }
            },
            "egress_timezone": {"type": ["string", "null"]},
            "preflight": {"type": "object"},
            "observer": {"const": "ipwho.is"}
          }
        },
        "gateway": {
          "type": "object",
          "additionalProperties": false,
          "required": ["process_identity", "endpoint", "lease_path", "ready_path", "preflight"],
          "properties": {
            "process_identity": {
              "type": "object",
              "additionalProperties": false,
              "required": ["pid", "executable", "start_marker"],
              "properties": {
                "pid": {"type": "integer", "minimum": 1},
                "executable": {"type": "string", "minLength": 1},
                "start_marker": {"type": "string", "minLength": 1}
              }
            },
            "endpoint": {"type": "string", "minLength": 1},
            "lease_path": {"type": "string", "minLength": 1},
            "ready_path": {"type": "string", "minLength": 1},
            "preflight": {
              "type": "object",
              "additionalProperties": true,
              "required": ["schema", "route_id", "route_sha256_16", "passed"],
              "properties": {
                "schema": {"const": "browser-core.network-preflight/1"},
                "route_id": {"type": "string", "minLength": 1},
                "route_sha256_16": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
                "passed": {"const": true}
              }
            }
          }
        }
      }
    },
    "trace_mode": {"enum": ["on", "off"]},
    "trace_category_contract": {"const": "browser-core.trace-categories/8"},
    "trace_scope": {"type": ["string", "null"], "enum": ["causal", "causal-stream", "encoding", "broad", "source-identity", "source-context", null]},
    "trace_categories": {
      "type": "array",
      "items": {"enum": ["browser_core.debug", "browser_core.stream", "blink.bindings", "blink.bindings.encoding", "browser_core.source_identity", "disabled-by-default-browser_core.source_context"]},
      "uniqueItems": true,
      "maxItems": 6
    },
    "trace_path": {"type": ["string", "null"]},
    "live_trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "path"],
      "dependentRequired": {"parts": ["byte_limit", "file_binding"]},
      "properties": {
        "schema": {"const": "browser-core.live-trace/1"},
        "path": {"type": "string", "minLength": 1},
        "byte_limit": {"type": "integer", "minimum": 4194304, "maximum": 1073741824, "multipleOf": 1048576},
        "parts": {
          "type": "object", "additionalProperties": false,
          "required": ["schema", "max_parts"],
          "properties": {
            "schema": {"const": "browser-core.recording-parts/1"},
            "max_parts": {"type": "integer", "minimum": 2, "maximum": 16}
          }
        },
        "file_binding": {
          "type": "object", "additionalProperties": false,
          "required": ["device", "inode", "prefix_bytes", "prefix_sha256"],
          "properties": {
            "device": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,39})$"},
            "inode": {"type": "string", "pattern": "^(0|[1-9][0-9]{0,39})$"},
            "prefix_bytes": {"type": "integer", "minimum": 1, "maximum": 65536},
            "prefix_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        }
      }
    },
    "value_capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "allowlist"],
      "properties": {
        "schema": {"enum": ["browser-core.inspection/1", "browser-core.inspection/2", "browser-core.inspection/3"]},
        "allowlist": {"enum": ["fingerprint-v1", "fingerprint-v2", "research-v3"]}
      },
      "oneOf": [
        {"properties": {"schema": {"const": "browser-core.inspection/1"}, "allowlist": {"const": "fingerprint-v1"}}},
        {"properties": {"schema": {"const": "browser-core.inspection/2"}, "allowlist": {"const": "fingerprint-v2"}}},
        {"properties": {"schema": {"const": "browser-core.inspection/3"}, "allowlist": {"const": "research-v3"}}}
      ]
    },
    "automation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transport", "cdp_endpoint"],
      "properties": {
        "transport": {"const": "cdp"},
        "cdp_endpoint": {"type": "string", "minLength": 1},
        "managed_target_url": {"type": "string", "minLength": 1, "maxLength": 8192}
      }
    }
  }
}
