{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:browser-core:runtime-launch-check:1",
  "title": "Browser Core explicit owned startup check",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "code", "message", "launch_verified", "launch_attempted", "browser_started", "renderer_verified", "cleanup_verified", "shutdown_mode", "headless_requested", "file_check", "session_file", "session_sha256", "receipt_written", "timings_seconds", "scope"],
  "properties": {
    "schema": {"const": "browser-core.runtime-launch-check/1"},
    "status": {"enum": ["passed", "failed"]},
    "code": {"enum": ["verified", "invalid-output", "output-custody-unavailable", "file-verification-failed", "launch-failed", "workspace-path-unavailable", "renderer-unavailable", "cleanup-failed", "non-graceful-stop", "interrupted", "receipt-unavailable", "session-receipt-unavailable"]},
    "message": {"type": "string", "minLength": 1, "maxLength": 1024},
    "launch_verified": {"type": "boolean"},
    "launch_attempted": {"type": "boolean"},
    "browser_started": {"type": ["boolean", "null"]},
    "renderer_verified": {"type": "boolean"},
    "cleanup_verified": {"type": ["boolean", "null"]},
    "shutdown_mode": {"type": ["string", "null"], "maxLength": 64},
    "headless_requested": {"type": ["boolean", "null"]},
    "file_check": {
      "type": ["object", "null"],
      "required": ["runtime_verified"],
      "properties": {"runtime_verified": {"type": "boolean"}}
    },
    "session_file": {"type": ["string", "null"], "pattern": "^sessions/[A-Za-z0-9_-]+\\.json$", "maxLength": 256},
    "session_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "receipt_written": {"type": "boolean"},
    "timings_seconds": {
      "type": "object", "additionalProperties": false, "required": ["total"],
      "properties": {
        "file_verification": {"type": "number", "minimum": 0},
        "launch": {"type": "number", "minimum": 0},
        "renderer": {"type": "number", "minimum": 0},
        "stop": {"type": "number", "minimum": 0},
        "total": {"type": "number", "minimum": 0}
      }
    },
    "scope": {"type": "string", "minLength": 1, "maxLength": 1024}
  },
  "allOf": [
    {
      "if": {"properties": {"launch_verified": {"const": true}}},
      "then": {
        "properties": {
          "status": {"const": "passed"}, "code": {"const": "verified"},
          "launch_attempted": {"const": true}, "browser_started": {"const": true},
          "renderer_verified": {"const": true}, "cleanup_verified": {"const": true},
          "shutdown_mode": {"const": "graceful"}, "receipt_written": {"const": true},
          "headless_requested": {"type": "boolean"},
          "session_file": {"type": "string"}, "session_sha256": {"type": "string"},
          "file_check": {"type": "object", "properties": {"runtime_verified": {"const": true}}}
        }
      },
      "else": {"properties": {"status": {"const": "failed"}, "code": {"not": {"const": "verified"}}}}
    },
    {
      "if": {"properties": {"browser_started": {"const": true}}},
      "then": {"properties": {"launch_attempted": {"const": true}, "session_file": {"type": "string"}}}
    }
  ]
}
