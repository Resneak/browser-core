   String host_timezone_id_ GUARDED_BY(lock_);
   String override_timezone_id_ GUARDED_BY(lock_);
+  // Destroy the owning handle before the state and lock it uses.
+  std::unique_ptr<TimeZoneOverride> evaluation_override_;
 };
 
