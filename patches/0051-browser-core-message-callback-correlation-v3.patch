+
+#ifndef THIRD_PARTY_BLINK_RENDERER_PLATFORM_INSTRUMENTATION_BROWSER_CORE_MESSAGE_DISPATCH_CONTEXT_H_
+#define THIRD_PARTY_BLINK_RENDERER_PLATFORM_INSTRUMENTATION_BROWSER_CORE_MESSAGE_DISPATCH_CONTEXT_H_
+
+#include <cstdint>
+#include <string_view>
+
+namespace blink {
+
+inline constinit thread_local std::uintptr_t
+    g_browser_core_message_dispatch_event = 0;
+inline constinit thread_local std::string_view
+    g_browser_core_message_dispatch_id;
+
+class BrowserCoreMessageDispatchScope final {
+ public:
+  BrowserCoreMessageDispatchScope(std::uintptr_t event,
+                                  std::string_view native_id)
+      : previous_event_(g_browser_core_message_dispatch_event),
+        previous_id_(g_browser_core_message_dispatch_id) {
+    g_browser_core_message_dispatch_event = event;
+    g_browser_core_message_dispatch_id = native_id;
+  }
+
+  BrowserCoreMessageDispatchScope(const BrowserCoreMessageDispatchScope&) =
+      delete;
+  BrowserCoreMessageDispatchScope& operator=(
+      const BrowserCoreMessageDispatchScope&) = delete;
+  BrowserCoreMessageDispatchScope(BrowserCoreMessageDispatchScope&&) = delete;
+  BrowserCoreMessageDispatchScope& operator=(
+      BrowserCoreMessageDispatchScope&&) = delete;
+
+  ~BrowserCoreMessageDispatchScope() {
+    g_browser_core_message_dispatch_event = previous_event_;
+    g_browser_core_message_dispatch_id = previous_id_;
+  }
+
+ private:
+  std::uintptr_t previous_event_;
+  std::string_view previous_id_;
+};
+
+inline std::uintptr_t CurrentBrowserCoreMessageDispatchEvent() {
+  return g_browser_core_message_dispatch_event;
+}
+
+inline std::string_view CurrentBrowserCoreMessageDispatchId() {
+  return g_browser_core_message_dispatch_id;
+}
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_PLATFORM_INSTRUMENTATION_BROWSER_CORE_MESSAGE_DISPATCH_CONTEXT_H_
