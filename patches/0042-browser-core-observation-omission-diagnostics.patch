+// Existing lifecycle guards can intentionally skip a selected observation.
+// Record only the fixed API label and guard reason. Do not inspect JavaScript
+// values or weaken the guard to obtain a more complete-looking recording.
+void RecordOmittedBinding(const char* api, const char* reason) {
+  TRACE_EVENT_INSTANT("browser_core.debug", "BrowserCoreInspection.OmittedBinding",
+      "schema", "browser-core.inspection-omission/1", "api", api, "reason", reason);
+}
 
