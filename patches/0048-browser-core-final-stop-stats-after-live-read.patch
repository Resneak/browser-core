+// A live read must not consume the final stop-outcome statistics.
+TEST_F(TracingServiceImplTest, OnTracingDisabledAfterLiveReadAcknowledged) {
+  std::unique_ptr<MockConsumer> consumer = CreateMockConsumer();
+  consumer->Connect(svc.get());
+  std::unique_ptr<MockProducer> producer = CreateMockProducer();
+  producer->Connect(svc.get(), "mock_producer");
+  producer->RegisterDataSource("data_source", /*ack_stop=*/true);
+
+  TraceConfig trace_config;
+  trace_config.add_buffers()->set_size_kb(128);
+  trace_config.add_data_sources()->mutable_config()->set_name("data_source");
+
+  consumer->EnableTracing(trace_config);
+  producer->WaitForTracingSetup();
+  producer->WaitForDataSourceSetup("data_source");
+  producer->WaitForDataSourceStart("data_source");
+
+  const auto live_packets = consumer->ReadBuffers();
+  const protos::gen::TraceStats* live_stats = nullptr;
+  for (const auto& packet : live_packets) {
+    if (packet.has_trace_stats())
+      live_stats = &packet.trace_stats();
+  }
+  ASSERT_NE(live_stats, nullptr);
+  EXPECT_EQ(live_stats->data_source_stop_timeouts(), 0u);
+  const auto stopped_id = producer->GetDataSourceInstanceId("data_source");
+  ASSERT_NE(stopped_id, 0u);
+
+  consumer->DisableTracing();
+  producer->WaitForDataSourceStop("data_source");
+  producer->endpoint()->NotifyDataSourceStopped(stopped_id);
+  consumer->WaitForTracingDisabled();
+
+  consumer->GetTraceStats();
+  const auto rpc_stats = consumer->WaitForTraceStats(true);
+  EXPECT_EQ(rpc_stats.data_source_stop_timeouts(), 0u);
+
+  const auto final_packets = consumer->ReadBuffers();
+  const protos::gen::TraceStats* final_stats = nullptr;
+  for (const auto& packet : final_packets) {
+    if (packet.has_trace_stats())
+      final_stats = &packet.trace_stats();
+  }
+  ASSERT_NE(final_stats, nullptr);
+  EXPECT_EQ(final_stats->data_source_stop_timeouts(), 0u);
+}
+
+// A live read must not consume the final stop-outcome statistics.
+TEST_F(TracingServiceImplTest, OnTracingDisabledAfterLiveReadTimeout) {
+  std::unique_ptr<MockConsumer> consumer = CreateMockConsumer();
+  consumer->Connect(svc.get());
+  std::unique_ptr<MockProducer> producer = CreateMockProducer();
+  producer->Connect(svc.get(), "mock_producer");
+  producer->RegisterDataSource("data_source", /*ack_stop=*/true);
+
+  TraceConfig trace_config;
+  trace_config.add_buffers()->set_size_kb(128);
+  trace_config.add_data_sources()->mutable_config()->set_name("data_source");
+  trace_config.set_data_source_stop_timeout_ms(1);
+  consumer->EnableTracing(trace_config);
+  producer->WaitForTracingSetup();
+  producer->WaitForDataSourceSetup("data_source");
+  producer->WaitForDataSourceStart("data_source");
+
+  const auto live_packets = consumer->ReadBuffers();
+  const protos::gen::TraceStats* live_stats = nullptr;
+  for (const auto& packet : live_packets) {
+    if (packet.has_trace_stats())
+      live_stats = &packet.trace_stats();
+  }
+  ASSERT_NE(live_stats, nullptr);
+  EXPECT_EQ(live_stats->data_source_stop_timeouts(), 0u);
+  const auto stopped_id = producer->GetDataSourceInstanceId("data_source");
+  ASSERT_NE(stopped_id, 0u);
+
+  consumer->DisableTracing();
+  producer->WaitForDataSourceStop("data_source");
+
+  consumer->WaitForTracingDisabled();
+  // A late acknowledgement must preserve the timeout outcome.
+  producer->endpoint()->NotifyDataSourceStopped(stopped_id);
+  consumer->GetTraceStats();
+  const auto rpc_stats = consumer->WaitForTraceStats(true);
+  EXPECT_EQ(rpc_stats.data_source_stop_timeouts(), 1u);
+
+  const auto final_packets = consumer->ReadBuffers();
+  const protos::gen::TraceStats* final_stats = nullptr;
+  for (const auto& packet : final_packets) {
     if (packet.has_trace_stats())
       final_stats = &packet.trace_stats();
   }
