+// Snapshot existing native ownership at binding entry. No debugger attachment,
+// page property reads, JavaScript coercion or persistent observer registry.
+base::DictValue ContextUrl(const KURL& url) {
+  base::DictValue out;
+  out.Set("not_fetch_provenance", true);
+  if (!url.IsValid() || url.GetString().length() > 16384) {
+    out.Set("status", "unavailable");
+    out.Set("reason", url.IsValid() ? "length-limit" : "invalid-url");
+    return out;
+  }
+  const std::string original = url.GetString().Utf8();
+  DigestValue digest;
+  if (!ComputeDigest(kHashAlgorithmSha256,
+        base::as_byte_span(std::string_view(original)), digest)) {
+    out.Set("status", "unavailable");
+    out.Set("reason", "digest-unavailable");
+    return out;
+  }
+  out.Set("status", "native-context-url");
+  out.Set("url_sha256", base::HexEncodeLower(digest));
+  KURL display_url(url);
+  display_url.SetUser(String());
+  display_url.SetPass(String());
+  display_url.SetQuery(String());
+  display_url.RemoveFragmentIdentifier();
+  std::string display;
+  if (display_url.ProtocolIsInHttpFamily()) {
+    display = display_url.GetString().Utf8();
+    if (display.size() > 512) display = "[URL exceeds display limit]";
+  } else if (display_url.GetString() == "about:blank" ||
+             display_url.GetString() == "about:srcdoc") {
+    display = display_url.GetString().Utf8();
+  } else {
+    // Blob/data/file/opaque URLs can embed source, local paths or credentials.
+    // Preserve a bounded digest, never their raw opaque content.
+    display = "[non-HTTP URL omitted]";
+  }
+  out.Set("display", display);
+  return out;
+}
