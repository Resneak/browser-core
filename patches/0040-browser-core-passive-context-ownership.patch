+std::string ContextMetadata(ScriptState* state, ExecutionContext* context) {
+  base::DictValue out;
+  out.Set("schema", "browser-core.inspection-context/1");
+  out.Set("context_id", context->GetExecutionContextToken().ToString());
+  out.Set("v8_context_id", state->GetToken().ToString());
+  out.Set("realm_id", state->World().GetWorldId());
+  out.Set("document_id", base::Value());
+  out.Set("frame_id", base::Value());
+  out.Set("parent_frame_id", base::Value());
+  out.Set("worker_id", base::Value());
+  out.Set("parent_context_id", base::Value());
+  const char* kind = "other";
+  if (context->IsWindow()) {
+    auto* window = To<LocalDOMWindow>(context);
+    if (auto* document = window->document())
+      out.Set("document_id", document->Token().ToString());
+    if (auto* frame = window->GetFrame()) {
+      kind = frame->IsMainFrame() ? "page" : "frame";
+      // Unlike Local/RemoteFrameToken, this token names the same frame node
+      // across renderer processes and matches Chromium's own frame identifier.
+      out.Set("frame_id", frame->GetDevToolsFrameToken().ToString());
+      if (auto* parent = frame->Parent())
+        out.Set("parent_frame_id", parent->GetDevToolsFrameToken().ToString());
+    } else {
+      kind = "detached-window";
+    }
+  } else if (context->IsWorkerGlobalScope()) {
+    kind = context->IsDedicatedWorkerGlobalScope() ? "dedicated-worker" :
+        context->IsSharedWorkerGlobalScope() ? "shared-worker" :
+        context->IsServiceWorkerGlobalScope() ? "service-worker" : "worker";
+    out.Set("worker_id", context->GetExecutionContextToken().ToString());
+    if (auto parent = context->GetParentExecutionContextToken())
+      out.Set("parent_context_id", parent->ToString());
+  }
+  out.Set("kind", kind);
+  out.Set("document_url", ContextUrl(context->Url()));
+  return base::WriteJson(out).value_or("{}");
+}
