diff --git a/third_party/perfetto/src/tracing/service/tracing_service_impl.cc b/third_party/perfetto/src/tracing/service/tracing_service_impl.cc
--- a/third_party/perfetto/src/tracing/service/tracing_service_impl.cc
+++ b/third_party/perfetto/src/tracing/service/tracing_service_impl.cc
@@ -2070,6 +2070,58 @@ void TracingServiceImpl::OnDisableTracingTimeout(TracingSessionID tsid) {
   PERFETTO_ILOG("Timeout while waiting for ACKs for tracing session %" PRIu64,
                 tsid);
   PERFETTO_DCHECK(!tracing_session->AllDataSourceInstancesStopped());
   ++tracing_session->data_source_stop_timeouts;
+  tracing_session->data_source_stop_timeout_pending_instances = 0;
+  tracing_session->data_source_stop_timeout_pending_producers = 0;
+  tracing_session->data_source_stop_timeout_details_truncated = false;
+  tracing_session->data_source_stop_timeout_details.clear();
+  constexpr size_t kMaxStopTimeoutDetails = 32;
+  std::set<ProducerID> pending_producers;
+  for (const auto& [producer_id, instance] :
+       tracing_session->data_source_instances) {
+    if (instance.state == DataSourceInstance::STOPPED)
+      continue;
+    ++tracing_session->data_source_stop_timeout_pending_instances;
+    pending_producers.insert(producer_id);
+    if (tracing_session->data_source_stop_timeout_details.size() >=
+        kMaxStopTimeoutDetails) {
+      tracing_session->data_source_stop_timeout_details_truncated = true;
+      continue;
+    }
+    ProducerEndpointImpl* producer = GetProducer(producer_id);
+    PERFETTO_DCHECK(producer);
+    base::FnvHasher producer_name_hash;
+    producer_name_hash.Update(producer->name_.data(), producer->name_.size());
+    base::FnvHasher data_source_name_hash;
+    data_source_name_hash.Update(instance.data_source_name.data(),
+                                 instance.data_source_name.size());
+    constexpr uint64_t kPositiveInt64Mask =
+        static_cast<uint64_t>(std::numeric_limits<int64_t>::max());
+    const uint64_t producer_hash =
+        producer_name_hash.digest() & kPositiveInt64Mask;
+    const uint64_t data_source_hash =
+        data_source_name_hash.digest() & kPositiveInt64Mask;
+    tracing_session->data_source_stop_timeout_details.push_back(
+        {static_cast<uint32_t>(producer_id),
+         static_cast<uint64_t>(instance.instance_id), producer_hash,
+         data_source_hash, static_cast<uint32_t>(instance.state)});
+    PERFETTO_ELOG(
+        "Browser Core stop timeout pending: producer=%u instance=%" PRIu64
+        " state=%u producer_name_fnv1a_63=%" PRIu64
+        " data_source_name_fnv1a_63=%" PRIu64,
+        static_cast<unsigned>(producer_id),
+        static_cast<uint64_t>(instance.instance_id),
+        static_cast<unsigned>(instance.state), producer_hash,
+        data_source_hash);
+  }
+  tracing_session->data_source_stop_timeout_pending_producers =
+      pending_producers.size();
+  PERFETTO_ELOG(
+      "Browser Core stop timeout summary: pending_instances=%" PRIu64
+      " pending_producers=%" PRIu64 " details=%zu truncated=%d",
+      tracing_session->data_source_stop_timeout_pending_instances,
+      tracing_session->data_source_stop_timeout_pending_producers,
+      tracing_session->data_source_stop_timeout_details.size(),
+      tracing_session->data_source_stop_timeout_details_truncated ? 1 : 0);
   DisableTracingNotifyConsumerAndFlushFile(tracing_session);
 }
