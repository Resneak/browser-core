+TEST_F(ProtoTraceReaderTest, DataSourceStopTimeoutDetails) {
+  auto* trace_stats = trace_->add_packet()->set_trace_stats();
+  trace_stats->set_data_source_stop_timeouts(1);
+  trace_stats->set_data_source_stop_timeout_pending_instances(2);
+  trace_stats->set_data_source_stop_timeout_pending_producers(1);
+  trace_stats->set_data_source_stop_timeout_details_truncated(true);
+  auto* detail = trace_stats->add_data_source_stop_timeout_details();
+  detail->set_producer_id(7);
+  detail->set_data_source_instance_id(11);
+  detail->set_producer_name_fnv1a_63(13);
+  detail->set_data_source_name_fnv1a_63(17);
+  detail->set_state(3);
+  detail = trace_stats->add_data_source_stop_timeout_details();
+  detail->set_producer_id(7);
+  detail->set_data_source_instance_id(12);
+  detail->set_producer_name_fnv1a_63(19);
+  detail->set_data_source_name_fnv1a_63(23);
+  detail->set_state(3);
+
+  ASSERT_TRUE(Tokenize().ok());
+  EXPECT_EQ(host_context_.stats_tracker->GetStats(
+                stats::traced_data_source_stop_timeouts),
+            1);
+  EXPECT_EQ(host_context_.stats_tracker->GetStats(
+                stats::traced_data_source_stop_timeout_pending_instances),
+            2);
+  EXPECT_EQ(host_context_.stats_tracker->GetStats(
+                stats::traced_data_source_stop_timeout_pending_producers),
+            1);
+  EXPECT_EQ(host_context_.stats_tracker->GetStats(
+                stats::traced_data_source_stop_timeout_details_truncated),
+            1);
+  auto indexed = [&](size_t key, int index) {
+    return host_context_.stats_tracker->GetIndexedStats(key, index).value_or(
+        -1);
+  };
+  EXPECT_EQ(indexed(stats::traced_data_source_stop_timeout_producer_id, 0),
+            7);
+  EXPECT_EQ(indexed(stats::traced_data_source_stop_timeout_instance_id, 0),
+            11);
+  EXPECT_EQ(
+      indexed(stats::traced_data_source_stop_timeout_producer_name_hash, 0),
+      13);
+  EXPECT_EQ(indexed(
+                stats::traced_data_source_stop_timeout_data_source_name_hash,
+                0),
+            17);
+  EXPECT_EQ(indexed(stats::traced_data_source_stop_timeout_state, 0), 3);
+  EXPECT_EQ(indexed(stats::traced_data_source_stop_timeout_producer_id, 1),
+            7);
+  EXPECT_EQ(indexed(stats::traced_data_source_stop_timeout_instance_id, 1),
+            12);
+  EXPECT_EQ(
+      indexed(stats::traced_data_source_stop_timeout_producer_name_hash, 1),
+      19);
+  EXPECT_EQ(indexed(
+                stats::traced_data_source_stop_timeout_data_source_name_hash,
+                1),
+            23);
+  EXPECT_EQ(indexed(stats::traced_data_source_stop_timeout_state, 1), 3);
+}
