+// they do not claim a document, frame, URL or initiating JavaScript caller.
+std::string LimitedContextMetadata(ScriptState* state,
+                                   ExecutionContext* context) {
+  base::DictValue out;
+  out.Set("schema", "browser-core.inspection-context/2");
+  out.Set("context_id", context->GetExecutionContextToken().ToString());
+  out.Set("v8_context_id", state->GetToken().ToString());
+  out.Set("realm_id", state->World().GetWorldId());
+  out.Set("context_kind", context->IsWindow() ? "window" :
+      context->IsWorkerGlobalScope() ? "worker" : "other");
+  out.Set("unavailable", "invalid-script-context");
+  return base::WriteJson(out).value_or("{}");
+}
