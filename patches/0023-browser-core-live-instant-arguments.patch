+TEST_F(SliceTrackerTest, BrowserCoreInstantArgsVisibleBeforeNextEvent) {
+  SliceTracker tracker(&context_);
+  constexpr TrackId track{22u};
+  const auto category = context_.storage->InternString("browser_core.debug");
+  const auto name = context_.storage->InternString("BrowserCoreInspection.BindingValue");
+  const auto parent = context_.storage->InternString("parent");
+  const auto key = context_.storage->InternString("debug.result_json");
+  tracker.Begin(1, track, category, parent);
+  const auto id = tracker.Scoped(2, track, category, name, 0,
+      [key](ArgsTracker::BoundInserter* args) {
+        args->AddArg(key, Variadic::Integer(24));
+      });
+  ASSERT_TRUE(id);
+  const auto& slices = context_.storage->slice_table();
+  ASSERT_EQ(slices.row_count(), 2u);
+  ASSERT_TRUE(slices[1].arg_set_id());
+  EXPECT_EQ(context_.storage->arg_table()[0].int_value(), 24);
+  EXPECT_EQ(slices[1].depth(), 1u);
+  EXPECT_EQ(slices[1].parent_id(), slices[0].id());
+  EXPECT_EQ(slices[0].dur(), -1);
+  tracker.End(5, track, category, parent);
+  EXPECT_EQ(slices[0].dur(), 4);
+  EXPECT_EQ(slices[1].dur(), 0);
+  EXPECT_EQ(context_.storage->arg_table().row_count(), 1u);
+}
+
+TEST_F(SliceTrackerTest, BrowserCoreEarlyArgsRequireExactInstant) {
+  constexpr TrackId track{22u};
+  const auto category = context_.storage->InternString("browser_core.debug");
+  const auto name = context_.storage->InternString("BrowserCoreInspection.BindingValue");
+  const auto other = context_.storage->InternString("unrelated");
+  const auto key = context_.storage->InternString("value");
+  for (int variant = 0; variant < 3; ++variant) {
+    SliceTracker tracker(&context_);
+    auto id = tracker.Scoped(10 * variant, track,
+        variant == 0 ? other : category, variant == 1 ? other : name,
+        variant == 2 ? 1 : 0,
+        [key](ArgsTracker::BoundInserter* args) {
+          args->AddArg(key, Variadic::Integer(7));
+        });
+    ASSERT_TRUE(id);
+    const auto& slices = context_.storage->slice_table();
+    EXPECT_FALSE(slices[slices.row_count() - 1].arg_set_id());
+  }
+}
