+void SliceTracker::CommitBrowserCoreInstantArgs(TrackId track_id) {
+  auto* track_info = FindTrackInfo(track_id);
+  PERFETTO_DCHECK(track_info && !track_info->slice_stack.empty());
+  auto& info = track_info->slice_stack.back();
+  // An instant's callback has supplied all its native values. Publish them
+  // now; waiting for a subsequent event leaves a visible row with no args at
+  // some live parse boundaries. Keep the stack and parent/duration semantics.
+  // Preserve the existing EOF translation path for any translatable args.
+  if (info.args &&
+      !info.args->NeedsTranslation(*context_->args_translation_table)) {
+    info.args.reset();
+  }
+}
