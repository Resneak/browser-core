+#if BUILDFLAG(BLINK_BINDINGS_TRACE_ENABLED)
+void AddBrowserCoreBindingAttribution(perfetto::EventContext& event) {
+  event.AddDebugAnnotation("stack_context_schema", "browser-core.js-stack/1");
+  auto* isolate = v8::Isolate::GetCurrent();
+  if (!isolate) {
+    event.AddDebugAnnotation("stack_context_status", "no-isolate");
+    return;
+  }
+  v8::HandleScope handles(isolate);
+  // Preserve the old immediate-script number as a separate observation. V8's
+  // ScriptData deliberately reports the root script for eval/regexp frames.
+  event.AddDebugAnnotation("script_id", v8::StackTrace::CurrentScriptId(isolate));
+  std::array<v8::StackTrace::ScriptData, 1> storage;
+  auto frames = v8::StackTrace::CurrentScriptData(isolate, storage);
+  if (frames.empty()) {
+    event.AddDebugAnnotation("stack_context_status", "no-visible-js-frame");
+    return;
+  }
+  auto* state = ScriptState::MaybeFrom(isolate, frames.front().context);
+  if (!state) {
+    event.AddDebugAnnotation("stack_context_status", "non-blink-context");
+    return;
+  }
+  // ScriptState's token remains usable when per-context data is disposed.
+  // Do not inspect a document, dereference disposed per-context data, enter a
+  // realm, run JavaScript, or expose a frame across V8's origin filtering.
+  event.AddDebugAnnotation("stack_context_status",
+      state->ContextIsValid() ? "observed" : "limited-context");
+  event.AddDebugAnnotation("stack_v8_context_id", state->GetToken().ToString());
+  event.AddDebugAnnotation("stack_realm_id", state->World().GetWorldId());
+  event.AddDebugAnnotation("stack_root_script_id", frames.front().id);
+}
+#endif
 
