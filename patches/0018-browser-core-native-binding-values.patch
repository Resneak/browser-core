+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+#include "third_party/blink/renderer/bindings/core/v8/browser_core_binding_observer.h"
+
+#include <array>
+#include <cmath>
+#include <bit>
+#include "base/command_line.h"
+#include "base/json/json_writer.h"
+#include "base/values.h"
+#include "third_party/blink/renderer/core/execution_context/execution_context.h"
+#include "third_party/blink/renderer/platform/bindings/dom_wrapper_world.h"
+#include "third_party/blink/renderer/platform/bindings/script_state.h"
+#include "third_party/blink/renderer/platform/instrumentation/tracing/trace_event.h"
+
+namespace blink {
+namespace {
+base::DictValue Number(double value) {
+  base::DictValue out;
+  out.Set("type", "number");
+  if (!std::isfinite(value)) {
+    out.Set("special", std::isnan(value) ? "nan" : value < 0 ? "-infinity" : "infinity");
+  } else if (value == 0 && std::signbit(value)) {
+    out.Set("special", "-0");
+  } else {
+    out.Set("value", value);
+  }
+  return out;
+}
+
+// Native WebGL getParameter returns short Int32Array/Float32Array capability
+// vectors. Copy their backing bytes without indexed property access. Shared,
+// detached, oversized and other objects are metadata-only.
+base::DictValue Observe(v8::Isolate* isolate, v8::Local<v8::Value> value,
+                          bool raw_result) {
+  base::DictValue out;
+  if (value.IsEmpty() || value->IsUndefined()) {
+    out.Set("type", "undefined");
+  } else if (value->IsNull()) {
+    out.Set("type", "null");
+  } else if (value->IsNumber()) {
+    return Number(value.As<v8::Number>()->Value());
+  } else if (value->IsBoolean()) {
+    out.Set("type", "boolean");
+    if (raw_result) out.Set("value", value.As<v8::Boolean>()->Value());
+  } else if (value->IsString()) {
+    auto string = value.As<v8::String>();
+    out.Set("type", "string");
+    out.Set("length", string->Length());
+    if (raw_result && string->Length() <= 1024) {
+      std::array<char, 4096> bytes;
+      size_t length = string->WriteUtf8(isolate, bytes.data(), bytes.size());
+      out.Set("value", std::string(bytes.data(), length));
+    } else {
+      out.Set("omitted", raw_result ? "length-limit" : "input-not-numeric");
+    }
+  } else if (raw_result && (value->IsInt32Array() || value->IsFloat32Array())) {
+    auto array = value.As<v8::TypedArray>();
+    out.Set("type", value->IsInt32Array() ? "Int32Array" : "Float32Array");
+    out.Set("length", static_cast<double>(array->Length()));
+    auto buffer = array->Buffer();
+    if (buffer->WasDetached() || buffer->GetBackingStore()->IsShared() || array->Length() > 64) {
+      out.Set("omitted", "buffer-not-readable-or-length-limit");
+    } else {
+      std::array<uint32_t, 64> bytes;
+      const size_t length = array->ByteLength();
+      if (array->CopyContents(bytes.data(), length) != length) {
+        out.Set("omitted", "buffer-changed");
+      } else {
+        base::ListValue values;
+        for (size_t offset = 0; offset < length; offset += 4) {
+          if (value->IsInt32Array()) {
+            int32_t element;
+            element = std::bit_cast<decltype(element)>(bytes[offset / 4]);
+            values.Append(Number(element));
+          } else {
+            float element;
+            element = std::bit_cast<decltype(element)>(bytes[offset / 4]);
+            values.Append(Number(element));
+          }
+        }
+        out.Set("values", std::move(values));
+      }
+    }
+  } else {
+    out.Set("type", value->IsProxy() ? "proxy" : value->IsSymbol() ? "symbol" :
+        value->IsBigInt() ? "bigint" : value->IsArray() ? "array" : "object");
+    out.Set("omitted", "no-object-inspection");
+  }
+  return out;
+}
+}  // namespace
+
+BrowserCoreBindingObserver::BrowserCoreBindingObserver(const char* api,
+    const v8::FunctionCallbackInfo<v8::Value>& info, bool parameter)
+    : api_(api), info_(info) {
+  static const bool requested = [] {
+    const auto* command = base::CommandLine::ForCurrentProcess();
+    return command->HasSwitch("browser-core-evaluation") &&
+        command->GetSwitchValueASCII("browser-core-inspect-values") == "fingerprint-v1";
+  }();
+  if (!requested || !TRACE_EVENT_CATEGORY_ENABLED("browser_core.debug")) return;
+  auto* isolate = info.GetIsolate();
+  if (!isolate->InContext() || isolate->HasPendingException()) return;
+  v8::HandleScope handles(isolate);
+  auto* state = ScriptState::MaybeFrom(isolate, isolate->GetCurrentContext());
+  if (!state || !state->ContextIsValid()) return;
+  auto* context = ExecutionContext::From(state);
+  if (!context) return;
+  context_id_ = context->GetExecutionContextToken().ToString();
+  context_kind_ = context->IsWindow() ? "window" : context->IsWorkerGlobalScope() ? "worker" : "other";
+  realm_id_ = state->World().GetWorldId();
+  script_id_ = v8::StackTrace::CurrentScriptId(isolate);
+  base::ListValue parameters;
+  if (parameter && info.Length() > 0) parameters.Append(Observe(isolate, info[0], false));
+  // Getter extras and WebGL arguments beyond pname are ignored by the native
+  // APIs. Retain the count, never unrelated values supplied by page code.
+  base::DictValue input;
+  input.Set("count", info.Length());
+  input.Set("observed", std::move(parameters));
+  parameters_ = base::WriteJson(input).value_or("{}");
+  enabled_ = true;
+}
+
+BrowserCoreBindingObserver::~BrowserCoreBindingObserver() {
+  if (!enabled_) return;
+  auto* isolate = info_.GetIsolate();
+  const bool exception = isolate->HasPendingException();
+  base::DictValue result;
+  if (exception) {
+    // Do not touch V8 values with a pending exception, or record exception text.
+    result.Set("type", "unavailable");
+    result.Set("omitted", "exception");
+  } else {
+    v8::HandleScope handles(isolate);
+    result = Observe(isolate, info_.GetReturnValue().Get(), true);
+  }
+  const std::string output = base::WriteJson(result).value_or("{}");
+  TRACE_EVENT_INSTANT("browser_core.debug", "BrowserCoreInspection.BindingValue",
+      "schema", "browser-core.inspection/1", "api", api_, "allowlist", "fingerprint-v1",
+      "context_id", context_id_, "context_kind", context_kind_,
+      "realm_id", realm_id_, "script_id", script_id_,
+      "completion", exception ? "exception" : "returned",
+      "parameters_json", parameters_, "result_json", output);
+}
+}  // namespace blink
