+def make_browser_core_binding_observer(cg_context):
+    logging_id = _make_bindings_logging_id(cg_context)
+    # Closed local fingerprint-v1 allowlist. Never observe storage, cookies,
+    # request bodies, credentials, cryptography, or arbitrary object fields.
+    navigator_getters = (
+        "hardwareConcurrency", "deviceMemory", "userAgent", "platform",
+        "language", "languages", "vendor", "product", "productSub",
+        "vendorSub", "appVersion", "appName", "appCodeName", "cookieEnabled",
+        "onLine", "maxTouchPoints", "webdriver", "pdfViewerEnabled",
+    )
+    screen_getters = ("width", "height", "availWidth", "availHeight",
+                      "availLeft", "availTop", "colorDepth", "pixelDepth")
+    allowed_getter = (
+        cg_context.attribute_get and (
+            (cg_context.class_like.identifier in ("Navigator", "WorkerNavigator")
+             and cg_context.attribute.identifier in navigator_getters)
+            or (cg_context.class_like.identifier == "Screen"
+                and cg_context.attribute.identifier in screen_getters)))
+    parameter = logging_id in (
+        "WebGLRenderingContext.getParameter", "WebGL2RenderingContext.getParameter")
+    if not (allowed_getter or parameter):
+        return None
+    assert cg_context.v8_callback_type == CodeGenContext.V8_FUNCTION_CALLBACK
+    observer = TextNode(
+        'BrowserCoreBindingObserver browser_core_observer("{}", ${{info}}, {});'
+        .format(logging_id, "true" if parameter else "false"))
+    observer.accumulate(CodeGenAccumulator.require_include_headers([
+        "third_party/blink/renderer/bindings/core/v8/browser_core_binding_observer.h"
+    ]))
+    return observer
