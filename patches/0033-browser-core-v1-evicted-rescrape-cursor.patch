+
+TEST_F(TraceBufferTest, BrowserCoreEvictedScrapeRejectsRegressiveRecommits) {
+  for (int kind = 0; kind < 4; ++kind) {
+    ResetBuffer(4096);
+    auto original = CreateChunk(ProducerID(1), WriterID(1), ChunkID(0));
+    if (kind == 3)
+      original.AddPacket({0xff, 0x7f}).AddPacket(20, 'b');
+    else
+      original.AddPacket(20, 'a').AddPacket(20, 'b');
+    original.PadTo(1008).CopyIntoTraceBuffer(kind == 2);
+    trace_buffer()->BeginRead();
+    SuppressClientDchecksForTesting();
+    if (kind == 3)
+      ASSERT_THAT(ReadPacket(), IsEmpty());
+    else
+      ASSERT_THAT(ReadPacket(), ElementsAre(FakePacketFragment(20, 'a')));
+    for (ChunkID i = 0; i < 4; ++i)
+      CreateChunk(ProducerID(2), WriterID(1), i)
+          .AddPacket(1008, 'x').CopyIntoTraceBuffer();
+    trace_buffer()->BeginRead();
+    while (!ReadPacket().empty()) {}
+    const auto violations = trace_buffer()->stats().abi_violations();
+    auto replacement = CreateChunk(ProducerID(1), WriterID(1), ChunkID(0));
+    replacement.AddPacket(20, 'a');
+    if (kind != 1) replacement.AddPacket(20, 'b');
+    replacement.PadTo(kind == 0 ? 496 : 1008).CopyIntoTraceBuffer(false);
+    EXPECT_EQ(violations + 1, trace_buffer()->stats().abi_violations()) << kind;
+    trace_buffer()->BeginRead();
+    ASSERT_THAT(ReadPacket(), IsEmpty()) << kind;
+  }
+}
+
+TEST_F(TraceBufferTest, BrowserCoreEvictedScrapeCompletionWithoutMoreFragments) {
+  ResetBuffer(4096);
+  CreateChunk(ProducerID(1), WriterID(1), ChunkID(0))
+      .AddPacket(20, 'a').AddPacket(20, 'b').AddPacket(20, 'c')
+      .PadTo(1008).CopyIntoTraceBuffer(false);
+  trace_buffer()->BeginRead();
+  ASSERT_THAT(ReadPacket(), ElementsAre(FakePacketFragment(20, 'a')));
+  ASSERT_THAT(ReadPacket(), ElementsAre(FakePacketFragment(20, 'b')));
+  ASSERT_THAT(ReadPacket(), IsEmpty());
+  for (ChunkID i = 0; i < 4; ++i)
+    CreateChunk(ProducerID(2), WriterID(1), i)
+        .AddPacket(1008, 'x').CopyIntoTraceBuffer();
+  trace_buffer()->BeginRead();
+  while (!ReadPacket().empty()) {}
+  CreateChunk(ProducerID(1), WriterID(1), ChunkID(0))
+      .AddPacket(20, 'a').AddPacket(20, 'b').PadTo(1008).CopyIntoTraceBuffer();
+  CreateChunk(ProducerID(1), WriterID(1), ChunkID(1))
+      .AddPacket(20, 'z').CopyIntoTraceBuffer();
+  trace_buffer()->BeginRead();
+  uint32_t dropped = 1;
+  ASSERT_THAT(ReadPacket(nullptr, &dropped), ElementsAre(FakePacketFragment(20, 'z')));
+  EXPECT_EQ(0u, dropped);
+  ASSERT_THAT(ReadPacket(), IsEmpty());
+}
+
+TEST_F(TraceBufferTest, BrowserCoreEvictedCursorDoesNotCrossWriterIdentity) {
+  for (bool other_producer : {false, true}) {
+    ResetBuffer(4096);
+    CreateChunk(ProducerID(1), WriterID(1), ChunkID(0))
+        .AddPacket(20, 'a').AddPacket(20, 'b').PadTo(1008).CopyIntoTraceBuffer(false);
+    trace_buffer()->BeginRead();
+    ASSERT_THAT(ReadPacket(), ElementsAre(FakePacketFragment(20, 'a')));
+    ASSERT_THAT(ReadPacket(), IsEmpty());
+    for (ChunkID i = 0; i < 4; ++i)
+      CreateChunk(ProducerID(2), WriterID(1), i)
+          .AddPacket(1008, 'x').CopyIntoTraceBuffer();
+    trace_buffer()->BeginRead();
+    while (!ReadPacket().empty()) {}
+    CreateChunk(ProducerID(other_producer ? 3 : 1), WriterID(other_producer ? 1 : 2), ChunkID(0))
+        .AddPacket(20, 'a').AddPacket(20, 'b').PadTo(1008).CopyIntoTraceBuffer(false);
+    trace_buffer()->BeginRead();
+    ASSERT_THAT(ReadPacket(), ElementsAre(FakePacketFragment(20, 'a')));
+    ASSERT_THAT(ReadPacket(), IsEmpty());
+  }
+}
