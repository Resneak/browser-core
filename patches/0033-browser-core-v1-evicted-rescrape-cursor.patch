-  // Last evicted chunk per existing writer sequence. A fully consumed,
-  // complete, uncorrupted tail proves continuity to its exact successor even
-  // after all old chunks have left the ring. No payload bytes are retained.
+  // Last evicted chunk per existing writer sequence. Keep its read cursor so
+  // an idle, partially written SMB chunk can be scraped again after eviction
+  // without emitting its consumed prefix twice. A complete clean tail also
+  // proves continuity to its exact successor. No payload bytes are retained.
   struct EvictedChunk {
     ChunkID id;
     bool clean_tail;
+    bool complete;
+    bool last_read_packet_skipped;
+    uint16_t record_size;
+    uint16_t num_fragments;
+    uint16_t num_fragments_read;
+    uint16_t cur_fragment_offset;
   };
   std::map<std::pair<ProducerID, WriterID>, EvictedChunk> last_evicted_chunk_;
 
