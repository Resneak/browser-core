+
+TEST_F(TraceBufferTest, BrowserCoreEvictedCleanTailAndChunkIdWrap) {
+  for (ChunkID id : {ChunkID(0), kMaxChunkID}) {
+    ResetBuffer(4096);
+    CreateChunk(ProducerID(1), WriterID(1), id).AddPacket(20, 'a').CopyIntoTraceBuffer();
+    trace_buffer()->BeginRead();
+    ASSERT_THAT(ReadPacket(), ElementsAre(FakePacketFragment(20, 'a')));
+    ASSERT_THAT(ReadPacket(), IsEmpty());
+    for (ChunkID i = 0; i < 4; ++i)
+      CreateChunk(ProducerID(2), WriterID(1), i).AddPacket(1008, 'x').CopyIntoTraceBuffer();
+    trace_buffer()->BeginRead();
+    while (!ReadPacket().empty()) {}
+    CreateChunk(ProducerID(1), WriterID(1), id + 1).AddPacket(20, 'b').CopyIntoTraceBuffer();
+    trace_buffer()->BeginRead();
+    uint32_t dropped = 1;
+    ASSERT_THAT(ReadPacket(nullptr, &dropped), ElementsAre(FakePacketFragment(20, 'b')));
+    EXPECT_EQ(0u, dropped);
+    ASSERT_THAT(ReadPacket(), IsEmpty());
+  }
+}
+
+TEST_F(TraceBufferTest, BrowserCoreEvictedUncertainTailsAndGapsStillReportLoss) {
+  // An unread packet, unfinished scrape, corrupt tail, missing chunk or
+  // incomplete fragment must never receive the clean-tail exemption.
+  for (int kind = 0; kind < 5; ++kind) {
+    ResetBuffer(4096);
+    auto chunk = CreateChunk(ProducerID(1), WriterID(1), ChunkID(0));
+    chunk.AddPacket(20, 'a');
+    if (kind == 0 || kind == 1) chunk.AddPacket(20, 'c');
+    if (kind == 2) chunk.AddPacket(20, 'c').ClearBytes(20, 1);
+    if (kind == 4) chunk.AddPacket(20, 'c', kContOnNextChunk);
+    chunk.CopyIntoTraceBuffer(/*chunk_complete=*/kind != 1);
+    trace_buffer()->BeginRead();
+    ASSERT_THAT(ReadPacket(), ElementsAre(FakePacketFragment(20, 'a')));
+    if (kind == 2) { SuppressClientDchecksForTesting(); ASSERT_THAT(ReadPacket(), IsEmpty()); }
+    for (ChunkID i = 0; i < 4; ++i)
+      CreateChunk(ProducerID(2), WriterID(1), i).AddPacket(1008, 'x').CopyIntoTraceBuffer();
+    trace_buffer()->BeginRead();
+    while (!ReadPacket().empty()) {}
+    CreateChunk(ProducerID(1), WriterID(1), ChunkID(kind == 3 ? 2 : 1))
+        .AddPacket(20, 'b').CopyIntoTraceBuffer();
+    trace_buffer()->BeginRead();
+    uint32_t dropped = 0;
+    ASSERT_THAT(ReadPacket(nullptr, &dropped), ElementsAre(FakePacketFragment(20, 'b')));
+    EXPECT_NE(0u, dropped) << "kind=" << kind;
+  }
+}
+
+TEST_F(TraceBufferTest, BrowserCoreEvictionHistoryUsesSequenceOrderAndClonePolicy) {
+  ResetBuffer(4096);
+  // Physical order is reversed; reading and retained history follow ChunkID.
+  CreateChunk(ProducerID(1), WriterID(1), ChunkID(2)).AddPacket(20, 'b').CopyIntoTraceBuffer();
+  CreateChunk(ProducerID(1), WriterID(1), ChunkID(1)).AddPacket(20, 'a').CopyIntoTraceBuffer();
+  trace_buffer()->BeginRead();
+  ASSERT_THAT(ReadPacket(), ElementsAre(FakePacketFragment(20, 'a')));
+  ASSERT_THAT(ReadPacket(), ElementsAre(FakePacketFragment(20, 'b')));
+  ASSERT_THAT(ReadPacket(), IsEmpty());
+  for (ChunkID i = 0; i < 4; ++i)
+    CreateChunk(ProducerID(2), WriterID(1), i).AddPacket(1008, 'x').CopyIntoTraceBuffer();
+  trace_buffer()->BeginRead();
+  while (!ReadPacket().empty()) {}
+  CreateChunk(ProducerID(1), WriterID(1), ChunkID(3)).AddPacket(20, 'c').CopyIntoTraceBuffer();
+  auto cloned = trace_buffer()->CloneReadOnly();
+  cloned->BeginRead();
+  uint32_t dropped = 1;
+  ASSERT_THAT(ReadPacket(cloned, nullptr, &dropped), ElementsAre(FakePacketFragment(20, 'c')));
+  EXPECT_EQ(!PERFETTO_FLAGS(BUFFER_CLONE_PRESERVE_READ_ITER), !!dropped);
+  trace_buffer()->BeginRead();
+  ASSERT_THAT(ReadPacket(nullptr, &dropped), ElementsAre(FakePacketFragment(20, 'c')));
+  EXPECT_EQ(0u, dropped);
+}
