 namespace {
 
+int BrowserCoreScriptId(Tagged<Object> script_object) {
+  if (!IsScript(script_object)) {
+    return -1;
+  }
+  const int script_id = Cast<Script>(script_object)->id();
+  return script_id >= 0 ? script_id : -1;
+}
+
+// V8's per-context debug ID, assigned by the embedder's inspector for every
+// Blink context (whether or not DevTools is attached). 0 means unassigned.
+int BrowserCoreDebugContextId(Tagged<NativeContext> native_context) {
+  Tagged<Object> value = native_context->debug_context_id();
+  return IsSmi(value) ? Smi::ToInt(value) : 0;
+}
+
+struct BrowserCoreDynamicCaller {
+  int script_id = -1;
+  int context_id = 0;
+};
+
+// The caller context always comes from the same source as the caller
+// ScriptId: the selected stack frame's own native context, or the eval
+// context when the outer function supplies the ScriptId.
+BrowserCoreDynamicCaller BrowserCoreDynamicCallerIdentity(
+    Isolate* isolate, DirectHandle<SharedFunctionInfo> outer_info,
+    DirectHandle<Context> context, bool prefer_stack_caller) {
+  BrowserCoreDynamicCaller stack;
+  DebuggableStackFrameIterator iterator(isolate);
+  if (!iterator.done() && iterator.is_javascript()) {
+    FrameSummary summary = iterator.GetTopValidFrame();
+    stack.script_id = BrowserCoreScriptId(*summary.script());
+    stack.context_id = BrowserCoreDebugContextId(*summary.native_context());
+  }
+  if (prefer_stack_caller && stack.script_id >= 0) {
+    return stack;
+  }
+  const int outer_script_id = BrowserCoreScriptId(outer_info->script());
+  if (outer_script_id >= 0) {
+    return {outer_script_id,
+            BrowserCoreDebugContextId(context->native_context())};
+  }
+  return stack;
+}
+
+void EmitBrowserCoreDynamicCodeMaterialized(
+    Isolate* isolate, DirectHandle<String> source,
+    DirectHandle<SharedFunctionInfo> outer_info, DirectHandle<Context> context,
+    DirectHandle<JSFunction> result, ParseRestriction restriction,
+    int parameters_end_pos, ParsingWhileDebugging parsing_while_debugging,
+    const char* cache_status) {
+  // Debugger expression compilation is control traffic, not page-created
+  // dynamic code. Excluding that compilation prevents the debugger wrapper
+  // itself from becoming evidence; eval/Function calls it executes remain
+  // observable.
+  if (parsing_while_debugging == ParsingWhileDebugging::kYes) {
+    return;
+  }
+  const bool is_function_constructor =
+      restriction == ONLY_SINGLE_FUNCTION_LITERAL &&
+      parameters_end_pos != kNoSourcePosition;
+  const int generated_script_id =
+      BrowserCoreScriptId(result->shared()->script());
+  if (generated_script_id < 0) {
+    return;
+  }
+  const char* dynamic_kind =
+      is_function_constructor ? "function-constructor" : "eval";
+  const BrowserCoreDynamicCaller caller = BrowserCoreDynamicCallerIdentity(
+      isolate, outer_info, context, is_function_constructor);
+  TRACE_EVENT_INSTANT(
+      "browser_core.debug", "BrowserCore.DynamicCodeMaterialized", "schema",
+      "browser-core.native/1", "event_category", "execution", "event_name",
+      "dynamic.code.materialized", "component", "v8.compiler", "dynamic_kind",
+      dynamic_kind, "cache_status", cache_status, "generated_script_id",
+      generated_script_id, "caller_script_id", caller.script_id,
+      "caller_inspector_context_id", caller.context_id, "source_length",
+      source->length());
+}
