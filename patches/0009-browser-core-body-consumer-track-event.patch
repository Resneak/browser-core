+void TraceBodyConsume(ScriptState* script_state, const char* consumer_mode) {
+  if (!TRACE_EVENT_CATEGORY_ENABLED("browser_core.stream")) {
+    return;
+  }
+  ExecutionContext* execution_context = ExecutionContext::From(script_state);
+  if (!execution_context) {
+    return;
+  }
+  const std::string context_id =
+      execution_context->GetExecutionContextToken().ToString();
+  const int script_id =
+      v8::StackTrace::CurrentScriptId(script_state->GetIsolate());
+  const int operation_id = execution_context->CircularSequentialID();
+  const std::string native_id =
+      base::StrCat({"body-consume:", context_id, ":",
+                    base::NumberToString(operation_id)});
+  const std::string script_native_id =
+      script_id < 0
+          ? std::string()
+          : base::StrCat({"script:", context_id, ":",
+                          base::NumberToString(script_id)});
+  const char* context_kind =
+      execution_context->IsWindow()
+          ? "frame"
+          : (execution_context->IsWorkerGlobalScope()
+                 ? "worker"
+                 : (execution_context->IsWorkletGlobalScope() ? "worklet"
+                                                               : "other"));
+  TRACE_EVENT_INSTANT(
+      "browser_core.stream", "BrowserCore.BodyConsume", "schema",
+      "browser-core.native/1", "event_category", "stream", "event_name",
+      "body.consume", "component", "blink.fetch-body", "context_id",
+      context_id, "context_kind", context_kind, "script_id", script_id,
+      "native_id", native_id, "native_parent_id", script_native_id,
+      "consumer_mode", consumer_mode);
+}
+
